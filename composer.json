{
    "name": "linecore/linecore-cms",
    "description": "Linecore CMS",
    "license": "proprietary",
    "authors": [
        {
            "name": "Linecore",
            "email": "sales@linecore.com"
        }
    ],
    "require": {
        "cartalyst/sentinel": "^6.0",
        "mcamara/laravel-localization": "1.8.*",
        "kalnoy/nestedset": "^6.0",
        "venturecraft/revisionable": "1.*",
        "intervention/image": "2.*",
        "intervention/imagecache": "2.*",
        "predis/predis" : "v1.1.1",
        "maatwebsite/excel": "3.*",
        "barryvdh/laravel-debugbar": "^3.5",
        "bkwld/cloner": "^3.10"
    },
    "autoload": {
        "classmap": [
            "src/Models",
            "src/libs",
            "src/Http/Controllers",
            "src/Http/ControllersNew",
            "src/Http/Services",
            "src/Http/Interfaces",
            "src/Http/Definitions",
            "src/Http/Fields",
            "src/Http/Traits",
            "src/Http/Middleware",
            "src/Console",
            "src/Migrations",
            "src/Seeds",
            "src/Settings"
        ],
        "psr-4": {
            "Linecore\\Cms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Linecore\\Cms\\CmsServiceProvider"
            ]
        }
    }
}
