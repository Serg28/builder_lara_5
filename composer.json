{
    "name": "vis/builder_lara_5",
    "description": "Builder cms",
    "license": "proprietary",
    "authors": [
        {
            "name": "vis",
            "email": "artur@vis-design.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Serg28/laravel-localization.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Serg28/imagecache.git"
        }
    ],
    "replace": {
        "intervention/imagecache": "*"
    },
    "require": {
        "cartalyst/sentinel": "^7",
        "mcamara/laravel-localization": "dev-master",
        "kalnoy/nestedset": "^6.0",
        "venturecraft/revisionable": "1.*",
        "intervention/image": "2.*",
        "intervention/imagecache": "dev-laravel10",
        "predis/predis": "2.*",
        "maatwebsite/excel": "3.*",
        "barryvdh/laravel-debugbar": "^3.5",
        "bkwld/cloner": "^3.10",
        "spatie/once": "^3.1"
    },
    "autoload": {
        "classmap": [
            "src/Models",
            "src/libs",
            "src/Http/Controllers",
            "src/Http/ControllersNew",
            "src/Http/Services",
            "src/Http/Interfaces",
            "src/Http/Definitions",
            "src/Http/Fields",
            "src/Http/Traits",
            "src/Http/Middleware",
            "src/Console",
            "src/Migrations",
            "src/Seeds",
            "src/Settings"
        ],
        "psr-4": {
            "Vis\\Builder\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vis\\Builder\\BuilderServiceProvider"
            ]
        }
    }
}
